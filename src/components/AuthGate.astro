---
// AuthGate.astro — full-page gate: nothing behind it renders until a Brotea
// account has been exchanged for a PocketBase session.
//
// Two factory gotchas are designed around, not worked around:
//  1. Astro scoped styles never match `createElement` DOM, so ALL markup here
//     is server-rendered and the script only flips `data-state`.
//  2. `[hidden]` loses to any author `display` rule, so visibility is a pair of
//     attribute selectors on this component's own id — it depends on no global
//     rule the host app may or may not have.
//
// The gate is OPEN by default: if JS never runs, protected content never
// appears. On success it sets `data-brotea-auth="<role>"` on <html> and fires
// `brotea:signedin`, so pages can start exactly like they do after any other
// async unlock.
import { t } from '../lib/i18n';

interface Props { locale: string }
const { locale } = Astro.props;
---

<div
  id="brotea-auth-gate"
  data-state="open"
  data-msg-error={t(locale, 'auth.error')}
  data-msg-denied={t(locale, 'auth.denied')}
  data-msg-offline={t(locale, 'auth.offline')}
  data-msg-sent={t(locale, 'auth.magic.sent')}
>
  <div class="auth-card">
    <h2 class="auth-title">{t(locale, 'auth.title')}</h2>
    <p class="auth-lead">{t(locale, 'auth.signin')}</p>

    <button type="button" class="auth-primary auth-google" id="brotea-auth-google">
      {t(locale, 'auth.google')}
    </button>
    <p class="auth-sep">{t(locale, 'auth.or')}</p>

    <form id="brotea-auth-form">
      <label>
        {t(locale, 'auth.email')}
        <input type="email" name="email" required autocomplete="username" />
      </label>
      <label>
        {t(locale, 'auth.password')}
        <input type="password" name="password" autocomplete="current-password" />
      </label>
      <button type="submit" class="auth-primary">{t(locale, 'auth.signin.submit')}</button>
      <button type="button" class="auth-link" id="brotea-auth-magic">{t(locale, 'auth.magic.submit')}</button>
      <p class="auth-msg" id="brotea-auth-msg" role="alert"></p>
    </form>
  </div>
</div>

<script>
  import { restore, signInWithPassword, sendMagicLink, signInWithProvider, AuthError, isConfigured } from '../lib/auth';

  const gate = document.getElementById('brotea-auth-gate') as HTMLElement;
  const form = document.getElementById('brotea-auth-form') as HTMLFormElement;
  const msg = document.getElementById('brotea-auth-msg') as HTMLElement;
  const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement;

  function open(user: { role: string }) {
    document.documentElement.setAttribute('data-brotea-auth', user.role);
    gate.dataset.state = 'closed';
    document.dispatchEvent(new CustomEvent('brotea:signedin', { detail: user }));
  }

  /** 403 is "no access", never "wrong password" — saying it wrong sends people
   *  to reset a password that was fine. */
  function explain(err: unknown): string {
    if (err instanceof AuthError && err.status === 403) return gate.dataset.msgDenied ?? '';
    if (err instanceof AuthError && err.status === 503) return gate.dataset.msgOffline ?? '';
    return gate.dataset.msgError ?? '';
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    msg.textContent = '';
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.disabled = true;
    try {
      open(await signInWithPassword(field('email').value, field('password').value));
    } catch (err) {
      msg.textContent = explain(err);
    } finally {
      btn.disabled = false;
    }
  });

  document.getElementById('brotea-auth-google')!.addEventListener('click', () => {
    // Leaves the page: the answer comes back to /auth/callback.
    signInWithProvider('google').catch(() => { msg.textContent = gate.dataset.msgError ?? ''; });
  });

  document.getElementById('brotea-auth-magic')!.addEventListener('click', async () => {
    msg.textContent = '';
    if (!field('email').reportValidity()) return;
    try {
      await sendMagicLink(field('email').value);
      msg.textContent = gate.dataset.msgSent ?? '';
    } catch (err) {
      msg.textContent = explain(err);
    }
  });

  // Boot: an already-signed-in browser must not see the form at all.
  (async () => {
    if (!isConfigured()) return; // unprovisioned app: leave the gate up, say nothing false
    const user = await restore();
    if (user) open(user);
  })();
</script>

<style>
  #brotea-auth-gate {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: var(--space-6) var(--space-4);
    overflow: auto;
    background: var(--bg);
  }
  /* one extra attribute beats the rule above without !important */
  #brotea-auth-gate[data-state='closed'] { display: none; }
  .auth-card,
  .auth-card * { box-sizing: border-box; }
  .auth-card {
    width: 100%;
    max-width: 420px;
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow);
    color: var(--text);
    font-family: var(--font-sans);
  }
  .auth-title { font-family: var(--font-display); font-size: 1.5rem; margin: 0 0 var(--space-3); }
  .auth-lead { color: var(--muted); margin: 0 0 var(--space-5); }
  label { display: block; margin-bottom: var(--space-4); font-weight: 600; font-size: .95rem; }
  input {
    display: block;
    width: 100%;
    margin-top: .35rem;
    padding: .55rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--text);
    font: inherit;
  }
  .auth-primary {
    padding: .7rem 1.6rem;
    border: 1px solid var(--primary);
    border-radius: var(--radius);
    background: var(--primary);
    color: var(--primary-contrast);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .auth-primary:hover { filter: brightness(0.92); }
  .auth-google { width: 100%; margin-bottom: var(--space-4); }
  .auth-sep {
    margin: 0 0 var(--space-4);
    color: var(--muted);
    font-size: .85rem;
    text-align: center;
  }
  .auth-primary:disabled { opacity: .5; cursor: progress; }
  .auth-link {
    display: block;
    margin-top: var(--space-4);
    padding: 0;
    border: 0;
    background: none;
    color: var(--muted);
    font: inherit;
    font-size: .85rem;
    text-decoration: underline;
    cursor: pointer;
  }
  .auth-link:hover { color: var(--primary); }
  .auth-msg { min-height: 1.2em; margin: var(--space-3) 0 0; color: var(--danger); font-size: .9rem; }
</style>
